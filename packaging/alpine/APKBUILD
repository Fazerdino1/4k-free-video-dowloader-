# Maintainer: Fazerdino1 <187407683+Fazerdino1@users.noreply.github.com>
pkgname=vidgrab
pkgver=0.2.0
pkgrel=0
pkgdesc="Open-source 4K/8K video & audio downloader (yt-dlp + ffmpeg) in Rust"
url="https://github.com/Fazerdino1/4k-free-video-dowloader-"
arch="x86_64 aarch64 armv7"
license="GPL-3.0-or-later"
depends="ca-certificates ffmpeg yt-dlp python3"
makedepends="cargo sqlite-dev openssl-dev"
subpackages="$pkgname-cli"
source="$pkgname-$pkgver.tar.gz"
options="!check"

build() {
	cargo build --release --locked -p vidgrab-cli
}

package() {
	install -Dm755 target/release/vidgrab-cli "$pkgdir"/usr/bin/vidgrab-cli
}

cli() {
	pkgdesc="$pkgdesc (headless musl CLI)"
	depends="ca-certificates ffmpeg yt-dlp python3"
	amove usr/bin/vidgrab-cli
}
